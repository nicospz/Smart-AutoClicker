<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false">

    <androidx.cardview.widget.CardView
        android:id="@+id/menu_background"
        style="@style/AppTheme.Overlay.FloatingMenu.CardView"
        android:animateLayoutChanges="false"
        tools:viewBindingIgnore="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btn_hub"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:layout_marginStart="@dimen/overlay_menu_padding_horizontal"
                android:layout_marginEnd="@dimen/overlay_menu_padding_horizontal"
                android:layout_marginTop="@dimen/overlay_menu_padding_vertical"
                android:layout_marginBottom="@dimen/overlay_menu_padding_vertical"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="@string/content_desc_scenario_menu_hub"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/hold_action_corner"
                android:layout_width="@dimen/overlay_hold_action_corner_size"
                android:layout_height="@dimen/overlay_hold_action_corner_size"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_overlay_hold_action_corner"
                app:layout_constraintEnd_toEndOf="@id/btn_hub"
                app:layout_constraintBottom_toBottomOf="@id/btn_hub"
                tools:ignore="ContentDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>
