<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to start the SmartAutoClickerService as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Needed to use the media projection with SmartAutoClickerService. Starting with SDK 34 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- Needed to display the overlay_menu over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Needed to keep the screen active while detecting, only if defined by the user. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Needed for the local 127.0.0.1 precision gesture helper socket. No remote network is used. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to run Tasker tasks via broadcast from scenario actions. -->
    <uses-permission android:name="net.dinglisch.android.tasker.PERMISSION_RUN_TASKS" />

    <queries>
        <package android:name="net.dinglisch.android.tasker" />
        <package android:name="net.dinglisch.android.taskerm" />
    </queries>

    <application
        android:name="${smartAutoClickerApplication}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_smart_auto_clicker"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_smart_auto_clicker_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="DataExtractionRules">

        <activity
            android:name="${scenarioActivity}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name="com.buzbuz.smartautoclicker.buttons.ButtonListActivity"
            android:exported="false" />

        <activity
            android:name="com.buzbuz.smartautoclicker.buttons.ButtonLayoutLauncherActivity"
            android:exported="true"
            android:theme="@style/AppTheme.TranslucentActivity"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.buttonlayout"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.buzbuz.smartautoclicker.action.START_BUTTON_LAYOUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.buzbuz.smartautoclicker.buttons.ButtonLayoutQSTileService"
            android:exported="true"
            android:label="@string/tile_label_start_button_layout"
            android:icon="@drawable/ic_dumb"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <activity
            android:name="com.buzbuz.smartautoclicker.scenarios.favorite.FavoriteScenarioLauncherActivity"
            android:exported="true"
            android:theme="@style/AppTheme.TranslucentActivity"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.favorite"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.buzbuz.smartautoclicker.action.START_FAVORITE_SCENARIO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.buzbuz.smartautoclicker.scenarios.favorite.FavoriteScenarioBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.buzbuz.smartautoclicker.action.SHOW_FAVORITE_SCENARIOS" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.buzbuz.smartautoclicker.scenarios.category.CategoryScenarioLauncherActivity"
            android:exported="true"
            android:theme="@style/AppTheme.TranslucentActivity"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.category"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="com.buzbuz.smartautoclicker.action.START_CATEGORY_SCENARIO" />
                <action android:name="com.buzbuz.smartautoclicker.action.START_SCENARIO_BY_NAME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.buzbuz.smartautoclicker.scenarios.category.CategoryScenarioBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.buzbuz.smartautoclicker.action.SHOW_CATEGORY_SCENARIOS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.buzbuz.smartautoclicker.localservice.ThrowletOverlayBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.buzbuz.smartautoclicker.action.START_THROWLET_OVERLAY" />
                <action android:name="com.buzbuz.smartautoclicker.action.TOGGLE_THROWLET_OVERLAY" />
                <action android:name="com.buzbuz.smartautoclicker.action.SHOW_THROWLET_OVERLAY" />
                <action android:name="com.buzbuz.smartautoclicker.action.HIDE_THROWLET_OVERLAY" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.buzbuz.smartautoclicker.settings.SettingsActivity"
            android:exported="false" />

        <service
            android:name="${smartAutoClickerService}"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="mediaProjection"
            android:exported="true">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibilityservice" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
